{
    "name": "accept-markdown/accept-markdown",
    "description": "Serve a post as Markdown when the Accept header prefers text/markdown.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "league/html-to-markdown": "5.1.4"
    },
    "require-dev": {
        "humbug/php-scoper": "0.18.20",
        "pestphp/pest": "5.3.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "build": [
            "php-scoper add-prefix --config=scoper.inc.php --output-dir=vendor_prefixed --force --no-interaction",
            "@composer dump-autoload --working-dir=vendor_prefixed --classmap-authoritative --no-interaction"
        ],
        "test": "pest"
    }
}
